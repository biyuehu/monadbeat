# MonadBeat backend configuration.
# Copy this file to `.env` and fill in the values below.
#
# Every setting in `app/config.py` can also be overridden here by its
# upper-cased name (e.g. `GHC_TIMEOUT_SEC`, `SUBMIT_RATE_LIMIT`); only the
# required ones are listed below.

# --- Required ---------------------------------------------------------------

# Random string used to sign JWTs.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/monadbeat

# GitHub OAuth app credentials (https://github.com/settings/developers).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public URL the backend is reachable at. Used for OAuth redirects.
SITE_URL=http://localhost:8000

# Frontend origin(s). Used for CORS and post-OAuth redirects.
# Comma-separated for multiple origins.
FRONTEND_URL=

# GitHub numeric ID of the single superadmin. Leave empty to disable.
# The matching account is forced to `is_admin = true` on every login, so the
# role survives DB resets. Obtain the ID via `https://api.github.com/users/<name>`
# (`id` field), or read it from the `user` table after a first login.
SUPERADMIN_GITHUB_ID=
