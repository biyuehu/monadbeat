{
    admin off
}

:80 {
    root * /srv/dist
    encode zstd gzip

    # Reverse proxy API endpoints to FastAPI backend
    @api path /problems* /submissions* /auth* /leaderboard* /me* /users* /admin* /docs* /openapi.json*
    reverse_proxy @api backend:8000

    # SPA routing: fall back to index.html for client-side routing
    try_files {path} /index.html
    file_server
}
