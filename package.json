{
  "name": "monadbeat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "gen-types": "uv run python -m scripts.export_openapi && bunx openapi-typescript openapi.json -o src/types/api-types.ts",
    "dev": "bun run gen-types && vite",
    "build": "bun run gen-types && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check",
    "fix": "biome check --write",
    "typecheck": "tsc -b",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "effect": "^3.22.2",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.13.3",
    "lefthook": "^2.2.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.2",
    "unocss": "^66.10.5",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14"
  }
}
